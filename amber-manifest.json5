{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      kimi_api_key: { type: "string", secret: true },
      nebius_api_key: { type: "string", secret: true },
      nebius_api_key_backup: { type: "string", secret: true },
    },
    required: ["kimi_api_key"],
    additionalProperties: false,
  },

  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  program: {
    image: "ghcr.io/yonghongzhang-io/purple-agent-officeqa:latest",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9009",

    env: {
      PORT: "9009",
      KIMI_API_KEY: "${config.kimi_api_key}",
      NEBIUS_API_KEY: "${config.nebius_api_key}",
      NEBIUS_API_KEY_BACKUP: "${config.nebius_api_key_backup}",
      LLM_PROVIDER: "kimi",
      KIMI_MODEL: "kimi-k2.5",
      NEBIUS_MODEL: "Qwen/Qwen3-235B-A22B-Instruct-2507",
      TREASURY_DATA_DIR: "/home/agent/treasury_data",
      ENABLE_TOOLS: "false",
      OFFICEQA_USE_TOOLS: "false",
      NEBIUS_ENABLE_TOOLS: "false",
      ENABLE_NUMERIC_AUDIT: "false",
      KIMI_THINKING: "false",
      HYBRID_ROUTING: "true",
      API_TIMEOUT_SECONDS: "45",
      HYBRID_HARD_PROVIDER: "nebius",
      HYBRID_HARD_MODEL: "Qwen/Qwen3-235B-A22B-Instruct-2507",
      HYBRID_CROSSCHECK_PROVIDER: "",
      HYBRID_CROSSCHECK_MODEL: "",
      MAX_SOURCE_FILES: "4",
      SOURCE_PREVIEW_CHARS: "12000",
      SOURCE_MAX_CHARS: "20000",
      MAX_LLM_CALLS: "3",
      MAX_TOKENS: "4000",
      MAX_API_RETRIES: "1",
      LLM_MAX_CONCURRENCY: "2",
      NUM_ROLLOUTS: "1",
      VOTE_TEMPERATURE: "0.3",
      CODE_TIMEOUT: "20",
    },

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: { a2a: "a2a" },
}
