{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      kimi_api_key: { type: "string", secret: true },
      anthropic_api_key: { type: "string", secret: true },
      nebius_api_key: { type: "string", secret: true },
      groq_api_key: { type: "string", secret: true },
      kimi_research_key_01: { type: "string", secret: true },
      kimi_research_key_02: { type: "string", secret: true },
      kimi_research_key_03: { type: "string", secret: true },
      kimi_research_key_04: { type: "string", secret: true },
    },
    required: ["kimi_api_key"],
    additionalProperties: false,
  },

  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  program: {
    image: "ghcr.io/yonghongzhang-io/purple-agent-officeqa:latest",
    entrypoint: "uv run src/server.py --host 0.0.0.0 --port 9009",

    env: {
      KIMI_API_KEY: "${config.kimi_api_key}",
      ANTHROPIC_API_KEY: "${config.anthropic_api_key}",
      NEBIUS_API_KEY: "${config.nebius_api_key}",
      GROQ_API_KEY: "${config.groq_api_key}",
      KIMI_RESEARCH_KEY_01: "${config.kimi_research_key_01}",
      KIMI_RESEARCH_KEY_02: "${config.kimi_research_key_02}",
      KIMI_RESEARCH_KEY_03: "${config.kimi_research_key_03}",
      KIMI_RESEARCH_KEY_04: "${config.kimi_research_key_04}",
      LLM_PROVIDER: "kimi",
      KIMI_MODEL: "kimi-k2.5",
      NEBIUS_MODEL: "deepseek-ai/DeepSeek-R1-0528",
      ANTHROPIC_MODEL: "claude-sonnet-4-6",
      GROQ_MODEL: "llama-3.3-70b-versatile",
      TREASURY_DATA_DIR: "/home/agent/treasury_data",
      ENABLE_TOOLS: "false",
      OFFICEQA_USE_TOOLS: "false",
      ENABLE_NUMERIC_AUDIT: "false",
      KIMI_THINKING: "false",
      MAX_SOURCE_FILES: "2",
      SOURCE_PREVIEW_CHARS: "8000",
      SOURCE_MAX_CHARS: "12000",
      MAX_LLM_CALLS: "4",
      MAX_TOKENS: "6000",
      MAX_API_RETRIES: "1",
      LLM_MAX_CONCURRENCY: "2",
      NUM_ROLLOUTS: "1",
      VOTE_TEMPERATURE: "0.4",
      CODE_TIMEOUT: "30",
    },

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: { a2a: "a2a" },
}
