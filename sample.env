# -----------------------------------------------------------------------
# Purple Agent — Environment Variables
# Copy to .env and fill in ONE provider's key
# -----------------------------------------------------------------------

# Default provider for the benchmark-safe submission:
LLM_PROVIDER=kimi
KIMI_API_KEY=sk-YOUR_KIMI_KEY_HERE
KIMI_MODEL=kimi-k2.5

# -----------------------------------------------------------------------
# OPTION B: Nebius / DeepSeek-R1
# -----------------------------------------------------------------------
# LLM_PROVIDER=nebius
# NEBIUS_API_KEY=YOUR_NEBIUS_KEY_HERE
# NEBIUS_MODEL=deepseek-ai/DeepSeek-R1-0528

# -----------------------------------------------------------------------
# OPTION C: Anthropic (alternative)
# -----------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=16000

# -----------------------------------------------------------------------
# OPTION D: Groq — FREE, no credit card, sign up at groq.com
# Good for testing, lower accuracy than Claude/GPT-4o
# -----------------------------------------------------------------------
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
# GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------
# OPTION E: OpenAI — if you already have a key
# -----------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-YOUR_KEY_HERE
# OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------
# OPTION F: DeepInfra — compatible fallback
# -----------------------------------------------------------------------
# LLM_PROVIDER=deepinfra
# DEEPINFRA_API_KEY=YOUR_DEEPINFRA_KEY_HERE
# DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# -----------------------------------------------------------------------
# Kimi round-robin keys (rate-limit avoidance)
# -----------------------------------------------------------------------
# KIMI_RESEARCH_KEY_01=sk-KEY1
# KIMI_RESEARCH_KEY_02=sk-KEY2
# KIMI_RESEARCH_KEY_03=sk-KEY3
# KIMI_RESEARCH_KEY_04=sk-KEY4

# -----------------------------------------------------------------------
# Agent behavior
# -----------------------------------------------------------------------
ENABLE_TOOLS=false
OFFICEQA_USE_TOOLS=false
ENABLE_NUMERIC_AUDIT=false
ENABLE_WEB_SEARCH=false
KIMI_THINKING=false
MAX_SOURCE_FILES=2
SOURCE_FOLLOWUP_YEARS=6
SOURCE_PREVIEW_CHARS=8000
SOURCE_MAX_CHARS=12000
MAX_LLM_CALLS=4
MAX_API_RETRIES=1
LLM_MAX_CONCURRENCY=2
MAX_TOKENS=6000
NUM_ROLLOUTS=3
VOTE_TEMPERATURE=0.4
CODE_TIMEOUT=30
