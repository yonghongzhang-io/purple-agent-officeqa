# -----------------------------------------------------------------------
# Purple Agent — Environment Variables
# Copy to .env and fill in ONE provider's key
# -----------------------------------------------------------------------

# Set this to your chosen provider:
# anthropic | openai | groq | nebius | deepinfra
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------
# RECOMMENDED: Anthropic (Claude) — best accuracy for competition
# -----------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=16000

# -----------------------------------------------------------------------
# OPTION B: Groq — FREE, no credit card, sign up at groq.com
# Good for testing, lower accuracy than Claude/GPT-4o
# -----------------------------------------------------------------------
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
# GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------
# OPTION C: Nebius — $50 FREE from competition credits
# -----------------------------------------------------------------------
# LLM_PROVIDER=nebius
# NEBIUS_API_KEY=YOUR_NEBIUS_KEY_HERE
# NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# -----------------------------------------------------------------------
# OPTION D: OpenAI — if you already have a key
# -----------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-YOUR_KEY_HERE
# OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------
# Agent behavior (same for all providers)
# -----------------------------------------------------------------------
ENABLE_TOOLS=true
ENABLE_WEB_SEARCH=false
MAX_LLM_CALLS=4
MAX_TOKENS=16000
